{
  "headers": [
    {
      "source": "/(packs-v2|bonus-extras)/(.*)\\.md",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/downloads/(.*)\\.mcpb",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Content-Type", "value": "application/octet-stream" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/screenshots/(.*)\\.mov",
      "headers": [
        { "key": "Content-Type", "value": "video/quicktime" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/screenshots/(.*)\\.mp4",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/(.*)\\.zip",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Content-Type", "value": "application/zip" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/perennialempiredashboard",
      "destination": "https://perennial-org-structure.vercel.app/"
    },
    {
      "source": "/perennialempiredashboard/",
      "destination": "https://perennial-org-structure.vercel.app/"
    },
    {
      "source": "/perennialempiredashboard/:path*",
      "destination": "https://perennial-org-structure.vercel.app/:path*"
    },
    {
      "source": "/((?!packs/|packs-v2/|assets/|favicon|icons|looms/|brand/|mockups/|perennialempiredashboard|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/EmpireWorksReconstruction",
      "destination": "/empireworksreconstruction",
      "permanent": true
    },
    {
      "source": "/EmpireWorksReconstruction/:path*",
      "destination": "/empireworksreconstruction/:path*",
      "permanent": true
    },
    {
      "source": "/PerennialEmpireDashboard",
      "destination": "/perennialempiredashboard",
      "permanent": true
    },
    {
      "source": "/PerennialEmpireDashboard/:path*",
      "destination": "/perennialempiredashboard/:path*",
      "permanent": true
    }
  ]
}
